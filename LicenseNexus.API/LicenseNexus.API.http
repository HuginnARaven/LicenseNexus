### createProduct
POST {{API_HostAddress}}/Product/
Content-Type: application/json

{
  "sku": "UUU332123",
  "title": "UnitTest Test",
  "shortDescription": "The Best Test UnitTest",
  "vendorId": {{new_vendor_id}},
  "productTypeId": {{new_product_type_id}},
  "unitMeasureId": {{new_unit_measure_id}},
  "currencyId": {{new_currency_id}},
  "productGroupId": {{new_product_group_id}},
  "quantityMin": 1,
  "quantityMax": 100,
  "startDate": "2022-01-01T00:00:00Z",
  "endDate": "2023-12-31T23:59:59Z",
  "isPromo": false,
  "isTop": false,
  "isNew": false,
  "logo": "http://example.com/logo.png",
  "author": "UnitTestTest"
}

> {%
    client.global.set("new_product_id", response.body.id);
    client.log("Created Product ID: " + client.global.get("new_product_id"));
%}

### getAllProducts
### GET {{API_HostAddress}}/Product/
### Accept: application/json

### getProductByID
GET {{API_HostAddress}}/Product/{{new_product_id}}/
Accept: application/json

### updateProduct
PUT {{API_HostAddress}}/Product/{{new_product_id}}/
Content-Type: application/json

{
  "sku": "UUU332123-UPDATED",
  "title": "UnitTest Product Updated",
  "shortDescription": "A test onit product updated",
  "vendorId": {{new_vendor_id}},
  "productTypeId": {{new_product_type_id}},
  "unitMeasureId": {{new_unit_measure_id}},
  "currencyId": {{new_currency_id}},
  "productGroupId": {{new_product_group_id}},
  "quantityMin": 1,
  "quantityMax": 100,
  "startDate": "2022-01-01T00:00:00Z",
  "endDate": "2023-12-31T23:59:59Z",
  "isPromo": false,
  "isTop": true,
  "isNew": true,
  "logo": "http://example.com/logo.png",
  "author": "UnitTestTester"
}

### patchProduct
PATCH {{API_HostAddress}}/Product/{{new_product_id}}/
Content-Type: application/json

{
  "sku": "UUU332123-PATCHED",
  "title": "UnitTest Product PATCHED",
  "shortDescription": "A unit product updated twice",
  "vendorId": 13071
}

### getProductByID
GET {{API_HostAddress}}/Product/{{new_product_id}}/
Accept: application/json

