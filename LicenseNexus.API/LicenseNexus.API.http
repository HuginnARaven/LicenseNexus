@API_HostAddress = http://localhost:5000/api

### createVendor
POST {{API_HostAddress}}/Vendor/
Content-Type: application/json

{
  "name": "UnitTestVendor2",
  "originalName": "UnitTestVendor1",
  "description": "UnitTestVendor1 description",
  "countryCode": "TST",
  "logo": "UnitTestTestVendor1.logo"
}

> {%
    client.global.set("new_vendor_id", response.body.id);
    client.log("Created Vendor ID: " + client.global.get("new_vendor_id"));
%}

### getAllVendors
GET {{API_HostAddress}}/Vendor/
Accept: application/json

### getVendorByID
GET {{API_HostAddress}}/Vendor/{{new_vendor_id}}/
Accept: application/json

### postCategory
POST {{API_HostAddress}}/Category/
Content-Type: application/json

{
  "categoryName": "UnitTestCategory",
  "isActive": true,
  "description": "UnitTestCategory Description",
  "author": "UnitTestTest"
}

> {%
    client.global.set("new_category_id", response.body.id);
    client.log("Created Category ID: " + client.global.get("new_category_id"));
%}

### getCategories
GET {{API_HostAddress}}/Category/
Accept: application/json

### getCategory by id
GET {{API_HostAddress}}/Category/{{new_category_id}}/
Accept: application/json

### createProductGroup
POST {{API_HostAddress}}/ProductGroup/
Content-Type: application/json

{
  "name": "UnitTestProductGroup",
  "isActive": true,
  "note": "UnitTestProductGroup description",
  "author": "UnitTestTest",
  "categoryId": {{new_category_id}}
}

> {%
    client.global.set("new_product_group_id", response.body.id);
    client.log("Created Category ID: " + client.global.get("new_product_group_id"));
%}

### getAllProductGroups
GET {{API_HostAddress}}/ProductGroup/
Accept: application/json

### getProductGroupByID
GET {{API_HostAddress}}/ProductGroup/{{new_product_group_id}}/
Accept: application/json

