### createOrder
POST {{API_HostAddress}}/Order/
Content-Type: application/json

{
  "CustomerId": 2,
  "OrderStatusId": 1002,
  "PostingDate": "2023-01-01T00:00:00Z",
  "InvoiceRequested": false
}

> {%
    client.global.set("new_order_id", response.body.id);
    client.log("Created Order ID: " + client.global.get("new_order_id"));
%}

### getAllOrders
GET {{API_HostAddress}}/Order/
Accept: application/json

### getOrderByID
GET {{API_HostAddress}}/Order/{{new_order_id}}/
Accept: application/json

### editlOrder
PUT {{API_HostAddress}}/Order/{{new_order_id}}/
Content-Type: application/json

{
  "CustomerId": 2,
  "OrderStatusId": 1002,
  "PostingDate": "2023-01-01T00:00:00Z",
  "InvoiceRequested": true
}

### createOrderProduct
POST {{API_HostAddress}}/Order/OrderProduct/
Content-Type: application/json

{
  "ProductId": 10,
  "PriceId": 8,
  "OrderId": {{new_order_id}},
  "Quantity": 10,
  "CustomerPrice": 10,
  "Status": "Created"
}

> {%
    client.global.set("new_order_product_id", response.body.id);
    client.log("Created OrderProduct ID: " + client.global.get("new_order_product_id"));
%}

### getOrders
GET {{API_HostAddress}}/Order/
Accept: application/json

### deleteOrderProduct
DELETE {{API_HostAddress}}/OrderProduct/{{new_order_product_id}}/
Accept: application/json

### getOrderByID
GET {{API_HostAddress}}/Order/{{new_order_id}}/
Accept: application/json

### deleteOrder
DELETE {{API_HostAddress}}/Order/{{new_order_id}}/
Accept: application/json